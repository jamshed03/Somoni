// Sentinel search: puts the target at the end, so the loop needs no index check.

// Returns the index of the target, or null if it is missing.
fn sentinel_search(input: list<int>, target: int): int? {
    const n: int = len(input);
    if (n == 0) {
        return null;
    }
    if (input[n - 1] == target) {
        return n - 1;
    }
    var items: list<int> = input;
    items[n - 1] = target;
    var i: int = 0;
    while (items[i] != target) {
        i += 1;
    }
    if (i < n - 1) {
        return i;
    }
    return null;
}

const numbers: list<int> = [4, 9, 1, 7, 3, 8];
for (target: int in [7, 4, 8, 5]) {
    if (var index = sentinel_search(numbers, target)) {
        print("{target}: {index}");
    } else {
        print("{target}: not found");
    }
}
