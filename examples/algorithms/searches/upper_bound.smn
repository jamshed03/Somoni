// Upper bound: the first position in a sorted list whose value is larger than the target. Source: TheAlgorithms/PHP Searches/UpperBound.php

// Returns the first index with items[index] > target, or len(items) if there is none.
fn upper_bound(items: list<int>, target: int): int {
    var low: int = 0;
    var high: int = len(items);
    while (low < high) {
        const mid: int = low + (high - low) / 2;
        if (items[mid] <= target) {
            low = mid + 1;
        } else {
            high = mid;
        }
    }
    return low;
}

const sorted: list<int> = [1, 2, 3, 3, 3, 4, 7, 9];
for (target: int in [3, 0, 5, 9, 10]) {
    print(string(target) + ": " + string(upper_bound(sorted, target)));
}
