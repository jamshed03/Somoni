// Exponential search: doubles the range until it passes the target, then searches binary in it.

// Returns the index of the target between low and high, or null.
fn binary_search(items: list<int>, target: int, low: int, high: int): int? {
    if (low > high) {
        return null;
    }
    const mid: int = low + (high - low) / 2;
    if (items[mid] == target) {
        return mid;
    }
    if (items[mid] < target) {
        return binary_search(items, target, mid + 1, high);
    }
    return binary_search(items, target, low, mid - 1);
}

// Returns the index of the target in the sorted list, or null if it is missing.
fn exponential_search(items: list<int>, target: int): int? {
    const n: int = len(items);
    if (n == 0) {
        return null;
    }
    if (items[0] == target) {
        return 0;
    }
    var bound: int = 1;
    while (bound < n && items[bound] <= target) {
        bound *= 2;
    }
    return binary_search(items, target, bound / 2, min(bound, n - 1));
}

const sorted: list<int> = [2, 3, 4, 10, 40, 50, 60, 70, 80, 90, 100];
for (target: int in [2, 10, 90, 100, 5]) {
    if (var index = exponential_search(sorted, target)) {
        print("{target}: {index}");
    } else {
        print("{target}: not found");
    }
}
