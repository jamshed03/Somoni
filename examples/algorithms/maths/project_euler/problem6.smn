// Project Euler 6: square of the sum minus sum of the squares of 1 to 100. Source: TheAlgorithms/PHP Maths/ProjectEuler/Problem6.php

// Returns (1 + ... + n)² - (1² + ... + n²).
fn problem6(n: int): int {
    var sum: int = 0;
    var sum_of_squares: int = 0;
    for (var i: int = 1; i <= n; i += 1) {
        sum += i;
        sum_of_squares += i * i;
    }
    return sum * sum - sum_of_squares;
}

print(problem6(100));
