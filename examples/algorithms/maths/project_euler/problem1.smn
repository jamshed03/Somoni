// Project Euler 1: sum of all multiples of 3 or 5 below 1000. Source: TheAlgorithms/PHP Maths/ProjectEuler/Problem1.php

// Returns the sum of all numbers below the limit that are divisible by 3 or 5.
fn problem1(limit: int): int {
    var total: int = 0;
    for (var n: int = 1; n < limit; n += 1) {
        if (n % 3 == 0 || n % 5 == 0) {
            total += n;
        }
    }
    return total;
}

print(problem1(1000));
