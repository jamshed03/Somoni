// Fibonacci numbers: every number is the sum of the two before it. Source: TheAlgorithms/PHP Maths/Fibonacci.php

// Returns the n-th Fibonacci number with recursion (slow, for small n).
fn fib_recursive(n: int): int {
    if (n < 2) {
        return n;
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

// Returns the first n Fibonacci numbers with a loop.
fn fib_sequence(n: int): list<int> {
    var result: list<int> = [];
    var a: int = 0;
    var b: int = 1;
    for (var i: int = 0; i < n; i += 1) {
        result += [a];
        const next: int = a + b;
        a = b;
        b = next;
    }
    return result;
}

print(fib_recursive(10));
print(fib_sequence(15));
