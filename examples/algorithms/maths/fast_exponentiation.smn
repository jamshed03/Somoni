// Fast exponentiation: squares the base and halves the exponent (O(log n) steps). Source: TheAlgorithms/PHP Maths/FastExponentiation.php

// Returns base to the power of a non-negative exponent.
fn fast_exponentiation(base: int, exponent: int): int {
    if (exponent == 0) {
        return 1;
    }
    if (exponent % 2 == 0) {
        return fast_exponentiation(base * base, exponent / 2);
    }
    return base * fast_exponentiation(base, exponent - 1);
}

print(fast_exponentiation(2, 10));
print(fast_exponentiation(3, 5));
print(fast_exponentiation(7, 0));
print(fast_exponentiation(2, 62));
