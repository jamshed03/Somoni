// Merge sort: splits the list in halves, sorts them and merges them back together.

// Returns one sorted list from two sorted lists.
fn merge(left: list<int>, right: list<int>): list<int> {
    var result: list<int> = [];
    var i: int = 0;
    var j: int = 0;
    while (i < len(left) && j < len(right)) {
        if (left[i] <= right[j]) {
            result += [left[i]];
            i += 1;
        } else {
            result += [right[j]];
            j += 1;
        }
    }
    return result + left.slice(i, len(left)) + right.slice(j, len(right));
}

// Returns a sorted copy of the list.
fn merge_sort(items: list<int>): list<int> {
    if (len(items) <= 1) {
        return items;
    }
    const middle: int = len(items) / 2;
    return merge(merge_sort(items.slice(0, middle)), merge_sort(items.slice(middle, len(items))));
}

print(merge_sort([38, 27, 43, 3, 9, 82, 10]));
print(merge_sort([]));
