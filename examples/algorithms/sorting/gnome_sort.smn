// Gnome sort: steps forward while in order, swaps and steps back otherwise. Source: TheAlgorithms/PHP Sorting/GnomeSort.php

// Returns a sorted copy of the list.
fn gnome_sort(input: list<int>): list<int> {
    var items: list<int> = input;
    var i: int = 1;
    while (i < len(items)) {
        if (i == 0 || items[i - 1] <= items[i]) {
            i += 1;
        } else {
            const tmp: int = items[i - 1];
            items[i - 1] = items[i];
            items[i] = tmp;
            i -= 1;
        }
    }
    return items;
}

print(gnome_sort([34, 2, 10, -9, 7, 1]));
print(gnome_sort([]));
