// Insertion sort: takes one element after another and moves it left to its place. Source: TheAlgorithms/PHP Sorting/InsertionSort.php

// Returns the list with the element at index moved left until the part before it is sorted.
fn insert_left(input: list<int>, index: int): list<int> {
    var items: list<int> = input;
    const value: int = items[index];
    var j: int = index - 1;
    while (j >= 0 && items[j] > value) {
        items[j + 1] = items[j];
        j -= 1;
    }
    items[j + 1] = value;
    return items;
}

// Returns a sorted copy of the list.
fn insertion_sort(input: list<int>): list<int> {
    var items: list<int> = input;
    for (var i: int = 1; i < len(items); i += 1) {
        items = insert_left(items, i);
    }
    return items;
}

print(insertion_sort([12, 11, 13, 5, 6]));
print(insertion_sort([]));
