// Count consonants: letters from a to z that are not vowels. Source: TheAlgorithms/PHP Strings/CountConsonants.php

import { chars, index_of, is_letter, lower_char } from "../lib/text.smn";

// Returns how many consonants the text has, ignoring upper and lower case.
fn count_consonants(text: string): int {
    const vowels: list<string> = chars("aeiou");
    var count: int = 0;
    for (c: string in text) {
        if (is_letter(c) && index_of(vowels, lower_char(c)) < 0) {
            count += 1;
        }
    }
    return count;
}

print(count_consonants("Hello World"));
print(count_consonants("Somoni is a language!"));
print(count_consonants("aeiou"));
