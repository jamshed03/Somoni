// Text helpers that Somoni does not have built in: letters and digits as single characters, and a string backwards.

// The digits up to base 36, so that "f" is 15.
const DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz";

// Returns the 26 lowercase letters of the English alphabet.
export fn lowercase_letters(): string {
    return "abcdefghijklmnopqrstuvwxyz";
}

// Returns the 26 uppercase letters of the English alphabet.
export fn uppercase_letters(): string {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
}

// Returns true if the character is one of a to z.
export fn is_lower(c: string): bool {
    return lowercase_letters().split("").contains(c);
}

// Returns true if the character is one of A to Z.
export fn is_upper(c: string): bool {
    return uppercase_letters().split("").contains(c);
}

// Returns true if the character is a letter from a to z or A to Z.
export fn is_letter(c: string): bool {
    return is_lower(c) || is_upper(c);
}

// Returns true if the character is one of 0 to 9.
export fn is_digit(c: string): bool {
    return "0123456789".split("").contains(c);
}

// Returns the string backwards, e.g. "abc" -> "cba".
export fn reverse(text: string): string {
    return text.split("").reverse().join("");
}

// Returns the value of a digit up to base 36, e.g. "7" -> 7, "f" -> 15, or -1 for other characters.
export fn digit_value(c: string): int {
    const position = DIGITS.split("").index_of(c.lower());
    if (position == null) {
        return -1;
    }
    return position;
}

// Returns the digit for a value from 0 to 35, e.g. 11 -> "b".
export fn digit_char(value: int): string {
    return DIGITS.split("")[value];
}
