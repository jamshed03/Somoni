// Segment tree: answers sum, min or max over any range and supports updates, both in O(log n). Source: TheAlgorithms/PHP DataStructures/SegmentTree/SegmentTree.php

// How two parts are combined; PHP passes a callback, Somoni has no function values yet.
enum Operation {
    Sum,
    Min,
    Max
}

// Returns the two values combined with the operation.
fn combine(operation: Operation, a: int, b: int): int {
    match (operation) {
        Operation.Sum => {
            return a + b;
        }
        Operation.Min => {
            if (a < b) {
                return a;
            }
            return b;
        }
        Operation.Max => {
            if (a > b) {
                return a;
            }
            return b;
        }
    }
}

// One node covers the elements from start to end and stores their combined value.
class SegmentTreeNode {
    start: int;
    end: int;
    value: int;
    left: SegmentTreeNode? = null;
    right: SegmentTreeNode? = null;

    constructor(start: int, end: int, value: int) {
        this.start = start;
        this.end = end;
        this.value = value;
    }
}

// Sets the value of an inner node from its two children.
fn recompute(node: SegmentTreeNode, operation: Operation): void {
    const left: SegmentTreeNode? = node.left;
    const right: SegmentTreeNode? = node.right;
    if (left != null && right != null) {
        node.value = combine(operation, left.value, right.value);
    }
}

// Returns the node for the elements from start to end with all nodes below it.
fn build(items: list<int>, start: int, end: int, operation: Operation): SegmentTreeNode {
    const node: SegmentTreeNode = new SegmentTreeNode(start, end, items[start]);
    if (start < end) {
        const mid: int = start + (end - start) / 2;
        node.left = build(items, start, mid, operation);
        node.right = build(items, mid + 1, end, operation);
        recompute(node, operation);
    }
    return node;
}

// A segment tree over a non-empty list of numbers.
class SegmentTree {
    private operation: Operation;
    private root: SegmentTreeNode;

    constructor(items: list<int>, operation: Operation) {
        this.operation = operation;
        this.root = build(items, 0, len(items) - 1, operation);
    }

    // Returns the combined value of the elements from start to end.
    query(start: int, end: int): int {
        return this.query_node(this.root, start, end);
    }

    // Returns the combined value of the part of start..end that this node covers.
    private query_node(node: SegmentTreeNode, start: int, end: int): int {
        const left: SegmentTreeNode? = node.left;
        const right: SegmentTreeNode? = node.right;
        const covered: bool = start <= node.start && node.end <= end;
        if (!covered && left != null && right != null) {
            if (end <= left.end) {
                return this.query_node(left, start, end);
            }
            if (start >= right.start) {
                return this.query_node(right, start, end);
            }
            return combine(this.operation, this.query_node(left, start, end), this.query_node(right, start, end));
        }
        return node.value;
    }

    // Sets the element at the index to the value.
    update(index: int, value: int): void {
        this.range_update(index, index, value);
    }

    // Sets every element from start to end to the value.
    range_update(start: int, end: int, value: int): void {
        this.update_node(this.root, start, end, value);
    }

    // Sets the elements of start..end below this node and recomputes the node.
    private update_node(node: SegmentTreeNode, start: int, end: int, value: int): void {
        const left: SegmentTreeNode? = node.left;
        const right: SegmentTreeNode? = node.right;
        if (left != null && right != null) {
            if (start <= left.end) {
                this.update_node(left, start, end, value);
            }
            if (end >= right.start) {
                this.update_node(right, start, end, value);
            }
            recompute(node, this.operation);
        } else {
            node.value = value;
        }
    }
}

const numbers: list<int> = [1, 3, 5, 7, 9, 11];
const sums: SegmentTree = new SegmentTree(numbers, Operation.Sum);
print(sums.query(0, 5));
print(sums.query(1, 3));
sums.update(1, 10);
print(sums.query(1, 3));
sums.range_update(3, 5, 0);
print(sums.query(0, 5));

const minimums: SegmentTree = new SegmentTree(numbers, Operation.Min);
print(minimums.query(2, 5));
const maximums: SegmentTree = new SegmentTree(numbers, Operation.Max);
print(maximums.query(0, 3));
