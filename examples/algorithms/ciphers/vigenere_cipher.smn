// Vigenère cipher: every letter is moved by the matching letter of a repeating key.

import { is_upper, lowercase_letters } from "../lib/text.smn";

// Returns the letter moved by shift places, keeping upper or lower case.
fn shift_letter(c: string, shift: int): string {
    const letters: list<string> = lowercase_letters().split("");
    const position = letters.index_of(c.lower());
    if (position == null) {
        return c;
    }
    const moved: string = letters[((position + shift) % 26 + 26) % 26];
    if (is_upper(c)) {
        return moved.upper();
    }
    return moved;
}

// Moves every letter by the key; direction is 1 to encrypt and -1 to decrypt.
fn vigenere(text: string, key: string, direction: int): string {
    const letters: list<string> = lowercase_letters().split("");
    const key_chars: list<string> = key.split("");
    var result: string = "";
    var key_index: int = 0;
    for (c: string in text) {
        const shift = letters.index_of(key_chars[key_index % len(key_chars)].lower());
        if (!letters.contains(c.lower()) || shift == null) {
            result += c;
        } else {
            result += shift_letter(c, shift * direction);
            key_index += 1;
        }
    }
    return result;
}

const secret: string = vigenere("Hello World", "KEY", 1);
print(secret);
print(vigenere(secret, "KEY", -1));
