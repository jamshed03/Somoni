// Atbash cipher: replaces a with z, b with y and so on.

import { index_of, is_upper, lowercase_letters } from "../lib/text.smn";

// Returns the mirrored letter for one character, other characters stay the same.
fn atbash_char(c: string): string {
    const letters: list<string> = lowercase_letters().split("");
    const position: int = index_of(letters, c.lower());
    if (position < 0) {
        return c;
    }
    const mirrored: string = letters[25 - position];
    if (is_upper(c)) {
        return mirrored.upper();
    }
    return mirrored;
}

// Encrypts the text; applying it twice gives the text back.
fn atbash(text: string): string {
    var result: string = "";
    for (c: string in text) {
        result += atbash_char(c);
    }
    return result;
}

const plain: string = "Hello World";
const secret: string = atbash(plain);
print(secret);
print(atbash(secret));
