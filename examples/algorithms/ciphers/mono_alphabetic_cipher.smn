// Mono-alphabetic cipher: every letter of the alphabet has a fixed partner in the key.

import { index_of, is_digit, is_upper } from "../lib/text.smn";

// Returns the partner of one character in the key, keeps spaces and drops digits.
fn substitute(c: string, from: list<string>, to: list<string>): string {
    if (is_digit(c)) {
        return "";
    }
    const position: int = index_of(from, c.lower());
    if (position < 0) {
        return c;
    }
    if (is_upper(c)) {
        return to[position].upper();
    }
    return to[position];
}

// Replaces every letter of the text from the alphabet with its partner in the key, or null if the lengths differ.
fn mono_alphabetic(key: string, alphabet: string, text: string): string? {
    if (len(key) != len(alphabet)) {
        return null;
    }
    const from: list<string> = alphabet.split("");
    const to: list<string> = key.split("");
    var result: string = "";
    for (c: string in text) {
        result += substitute(c, from, to);
    }
    return result;
}

const alphabet: string = "abcdefghijklmnopqrstuvwxyz";
const key: string = "yhkqgvxfoluapwmtzecjdbsnri";
const secret: string? = mono_alphabetic(key, alphabet, "I love 1 GitHub");
print(secret);
if (secret != null) {
    print(mono_alphabetic(alphabet, key, secret));
}
print(mono_alphabetic("abc", alphabet, "test"));
