// Binary search: halves a sorted list until the value is found.

// Returns the index of target in the sorted list, or null if it is missing.
fn binary_search(items: list<int>, target: int): int? {
    var low: int = 0;
    var high: int = len(items) - 1;
    while (low <= high) {
        var mid: int = low + (high - low) / 2;
        if (items[mid] == target) {
            return mid;
        } else if (items[mid] < target) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return null;
}

const sorted: list<int> = [1, 3, 5, 7, 9, 11, 13];
print(sorted);
for (target: int in [1, 7, 13, 4, 20]) {
    var index: int? = binary_search(sorted, target);
    if (index != null) {
        print(string(target) + " found at index " + string(index));
    } else {
        print(string(target) + " not found");
    }
}
