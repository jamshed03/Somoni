// A robot drives over a level: the player steers it with w, a, s and d, collects dirt, avoids traps and looks for the exit.

import { Effect, Tile } from "lib/tiles.smn";
import * as level from "lib/level.smn";

enum Direction {
    Up,
    Down,
    Left,
    Right
}

// Returns the direction for a command sign, a small factory for directions.
fn direction_of(sign: string): result<Direction, string> {
    match (sign) {
        "w" => {
            return ok(Direction.Up);
        }
        "s" => {
            return ok(Direction.Down);
        }
        "a" => {
            return ok(Direction.Left);
        }
        "d" => {
            return ok(Direction.Right);
        }
        _ => {
            return err("unbekannter Befehl '{sign}'");
        }
    }
}

// Returns how far one step in `direction` goes, as (dx, dy).
fn step_of(direction: Direction): (int, int) {
    match (direction) {
        Direction.Up => {
            return (0, -1);
        }
        Direction.Down => {
            return (0, 1);
        }
        Direction.Left => {
            return (-1, 0);
        }
        Direction.Right => {
            return (1, 0);
        }
    }
}

class Robot {
    x: int;
    y: int;
    energy: int = 12;
    collected: int = 0;
    finished: bool = false;

    constructor(start: (int, int)) {
        this.x = start.0;
        this.y = start.1;
    }

    position(): (int, int) {
        return (this.x, this.y);
    }

    can_go_on(): bool {
        return !this.finished && this.energy > 0;
    }
}

class Game {
    private map: level.Level;
    private robot: Robot;

    constructor(map: level.Level) {
        this.map = map;
        this.robot = new Robot(map.start);
    }

    is_over(): bool {
        return !this.robot.can_go_on();
    }

    run(commands: string): void {
        for (sign: string in commands) {
            if (this.is_over()) {
                break;
            }
            match (direction_of(sign)) {
                ok(direction: Direction) => {
                    this.move(direction);
                }
                err(message: string) => {
                    print(message);
                }
            }
        }
    }

    private move(direction: Direction): void {
        var (dx: int, dy: int) = step_of(direction);
        this.robot.energy--;
        var tile: Tile? = this.map.tile_at(this.robot.x + dx, this.robot.y + dy);
        if (tile == null || !tile.can_enter()) {
            print("Rums, Wand bei {this.robot.x + dx},{this.robot.y + dy}");
            return;
        }
        this.robot.x += dx;
        this.robot.y += dy;
        match (tile.enter()) {
            Effect.Nothing => {
            }
            Effect.Collect => {
                this.robot.collected++;
            }
            Effect.Hurt => {
                this.robot.energy -= 3;
                print("Autsch, eine Falle");
            }
            Effect.Finish => {
                this.robot.finished = true;
            }
        }
    }

    show(): void {
        for (line: string in this.map.render(this.robot.position())) {
            print(line);
        }
    }

    report(): string {
        var state: string = "kein Strom mehr";
        if (this.robot.finished) {
            state = "am Ausgang";
        } else if (this.robot.energy > 0) {
            state = "unterwegs";
        }
        return "Schmutz: {this.robot.collected}, Energie: {this.robot.energy}, {state}";
    }
}

var lines: list<string> = [
    "#######",
    "#R.*.^#",
    "#.#*#.#",
    "#*...E#",
    "#######"
];
match (level.Level::parse(lines)) {
    ok(map: level.Level) => {
        var game = new Game(map);
        print("Steuern mit w, a, s, d (auch mehrere, z. B. dd), q beendet.");
        game.show();
        var line = input();
        while (line != null && !game.is_over()) {
            if (line == "q") {
                break;
            }
            game.run(line);
            print("");
            game.show();
            line = input();
        }
        print(game.report());
    }
    err(message: string) => {
        print("Karte kaputt: {message}");
    }
}

match (level.Level::parse(["#?#"])) {
    ok(_) => {
    }
    err(message: string) => {
        print("Karte kaputt: {message}");
    }
}
