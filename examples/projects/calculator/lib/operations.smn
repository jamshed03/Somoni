// The operations of the calculator: an interface, an abstract base class, one class per operator and a factory.

// What the parser needs to know about an operator: its sign, how strongly it binds, and how it computes.
export interface Operation {
    symbol(): string;
    precedence(): int;
    right_associative(): bool;
    apply(a: float, b: float): result<float, string>;
}

// Keeps the sign and the precedence; the subclasses only say how they compute.
export abstract class BinaryOperation implements Operation {
    private sign: string;
    private level: int;

    constructor(sign: string, level: int) {
        this.sign = sign;
        this.level = level;
    }

    symbol(): string {
        return this.sign;
    }

    precedence(): int {
        return this.level;
    }

    right_associative(): bool {
        return false;
    }

    abstract apply(a: float, b: float): result<float, string>;
}

export class Add extends BinaryOperation {
    constructor() {
        super("+", 1);
    }

    override apply(a: float, b: float): result<float, string> {
        return ok(a + b);
    }
}

export class Subtract extends BinaryOperation {
    constructor() {
        super("-", 1);
    }

    override apply(a: float, b: float): result<float, string> {
        return ok(a - b);
    }
}

export class Multiply extends BinaryOperation {
    constructor() {
        super("*", 2);
    }

    override apply(a: float, b: float): result<float, string> {
        return ok(a * b);
    }
}

export class Divide extends BinaryOperation {
    constructor() {
        super("/", 2);
    }

    override apply(a: float, b: float): result<float, string> {
        if (b == 0.0) {
            return err("Division durch 0");
        }
        return ok(a / b);
    }
}

export class Power extends BinaryOperation {
    constructor() {
        super("^", 3);
    }

    override right_associative(): bool {
        return true;
    }

    override apply(a: float, b: float): result<float, string> {
        if (a < 0.0 && floor(b) != ceil(b)) {
            return err("keine Wurzel aus einer negativen Zahl");
        }
        return ok(pow(a, b));
    }
}

// The factory: makes the operation for a sign, so that the parser never names a class itself.
export class OperationFactory {
    private constructor() {
    }

    static is_operator(sign: string): bool {
        return ["+", "-", "*", "/", "^"].contains(sign);
    }

    static create(sign: string): result<Operation, string> {
        if (sign == "+") {
            return ok(new Add());
        }
        if (sign == "-") {
            return ok(new Subtract());
        }
        if (sign == "*") {
            return ok(new Multiply());
        }
        if (sign == "/") {
            return ok(new Divide());
        }
        if (sign == "^") {
            return ok(new Power());
        }
        return err("unbekannter Operator '" + sign + "'");
    }
}
