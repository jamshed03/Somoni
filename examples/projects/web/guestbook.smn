// A guestbook: a form sends a name and a message with POST, the entries are kept in data/guestbook.txt.
// It only works under somoni serve; as a normal program it shows how to start it.

const ENTRIES = "data/guestbook.txt";

// Returns the saved entries, one per line, or none if there is no file yet.
fn entries(): list<string> {
    match (read_file(ENTRIES)) {
        ok(text: string) => {
            return text.split("\n").filter(fn(line) => line != "");
        }
        err(_) => {
            return [];
        }
    }
}

// Saves a new entry and sends the browser back to the list, or returns a problem to show.
fn add_entry(name: string?, message: string?): string? {
    if (name == null || message == null || name.trim() == "" || message.trim() == "") {
        set_status(422);
        return "Please fill in your name and a message.";
    }
    var text = message.replace("\r\n", " ").replace("\n", " ").trim();
    var all = entries() + ["{name.trim()}: {text}"];
    match (write_file(ENTRIES, all.join("\n") + "\n")) {
        ok(_) => {
            redirect("/guestbook");
            return null;
        }
        err(reason: string) => {
            set_status(500);
            return reason;
        }
    }
}

print("<!doctype html>");
print("<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Guestbook</title></head><body>");
print("<h1>Guestbook</h1>");
if (request_method() == "") {
    print("<p>Start it with: somoni serve examples/projects/web, then open /guestbook.</p>");
} else {
    if (request_method() == "POST") {
        if (var problem = add_entry(form("name"), form("message"))) {
            print("<p><strong>{problem.escape_html()}</strong></p>");
        }
    }
    print("<form method=\"post\" action=\"guestbook\">");
    print("<p><input name=\"name\" placeholder=\"Name\"></p>");
    print("<p><textarea name=\"message\" placeholder=\"Message\"></textarea></p>");
    print("<p><button>Send</button></p>");
    print("</form>");
    print("<ul>");
    for (entry: string in entries()) {
        print("<li>{entry.escape_html()}</li>");
    }
    print("</ul>");
}
print("<p><a href=\"/\">Back</a></p>");
print("</body></html>");
