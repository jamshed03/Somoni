// Builds the documentation site of Somoni with Somoni: one HTML file per section in site/, and site/index.html.

import { Section, load_section } from "lib/content.smn";
import { layout } from "lib/layout.template.smn";
import { overview } from "lib/overview.template.smn";
import { section as show_section } from "lib/section.template.smn";

const VERSION = "0.13.0";

// Writes `text` into site/`name` and tells what was written.
fn save(name: string, text: string): void {
    match (write_file("site/{name}", text)) {
        ok(characters: int) => {
            print("wrote site/{name} ({characters} characters)");
        }
        err(reason: string) => {
            print(reason);
        }
    }
}

// Writes one page with the layout around `body`; `current` is the id of the page shown active in the nav.
fn write_page(name: string, title: string, sections: list<Section>, body: string, current: string): void {
    save(name, capture(fn() => layout(VERSION, title, sections, body, current)));
}

// Copies the file `from` into site/`to` byte for byte, like the stylesheet, the logo or an image.
fn copy_asset(from: string, to: string): void {
    match (copy_file(from, "site/{to}")) {
        ok(bytes: int) => {
            print("copied site/{to} ({bytes} bytes)");
        }
        err(reason: string) => {
            print(reason);
        }
    }
}

var sections: list<Section> = [];
for (id: string in [
    "start", "getting-started", "types", "collections", "control-flow", "functions", "errors",
    "classes", "modules", "standard-library", "templates", "web-server", "best-practices", "how-it-works", "error-codes"
]) {
    match (load_section(id)) {
        ok(section: Section) => {
            sections += [section];
        }
        err(reason: string) => {
            print(reason);
        }
    }
}

copy_asset("../../../somoni-logo.svg", "somoni-logo.svg");
copy_asset("lib/style.css", "style.css");
copy_asset("content/lifecycle.svg", "lifecycle.svg");
write_page("index.html", "Contents", sections, capture(fn() => overview(sections)), "");
for (section: Section in sections) {
    write_page("{section.id}.html", section.title, sections, capture(fn() => show_section(section)), section.id);
}
