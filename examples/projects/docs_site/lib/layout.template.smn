{{-- The frame of every page: head with styles, a header with the logo and the nav, the page body, a footer --}}
@import { Section } from "content.smn"
@props(version: string, title: string, sections: list<Section>, body: string, current: string)
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} - Somoni {{ version }}</title>
    <link rel="icon" href="somoni-logo.svg" type="image/svg+xml">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <div class="brand-row">
            <a class="brand" href="index.html">
                <img src="somoni-logo.svg" alt="">
                <span>Somoni</span>
            </a>
            <span class="version">v{{ version }}</span>
        </div>
        <nav>
            @foreach (section: Section in sections)
            @if (section.id == current)
            <a href="{{ section.id }}.html" class="active" aria-current="page">{{ section.title }}</a>
            @else
            <a href="{{ section.id }}.html">{{ section.title }}</a>
            @endif
            @endforeach
        </nav>
    </header>
    <main>
{!! body !!}
    </main>
    <footer>
        <p>Somoni is free software under the <a href="https://github.com/jamshed03/Somoni/blob/main/LICENSE">MIT license</a>. Source on <a href="https://github.com/jamshed03/Somoni">GitHub</a>.</p>
    </footer>
</body>
</html>
