{{-- The start page: every section as a card with its title and its first sentence --}}
@import { Section } from "content.smn"
@props(sections: list<Section>)
<h1>Documentation</h1>
<p>Everything you need to learn Somoni, from the first program to templates and a web server.</p>
<div class="cards">
    @foreach (section: Section in sections)
    <a class="card" href="{{ section.id }}.html">
        <h2>{{ section.title }}</h2>
        <p>{!! section.intro !!}</p>
    </a>
    @endforeach
</div>
