{{-- One section of the documentation: title, text, an example and notes --}}
@import { Section } from "content.smn"
@props(section: Section)
<section id="{{ section.id }}">
    <h2>{{ section.title }}</h2>
    <p>{{ section.intro }}</p>
    <pre><code>{{ section.example }}</code></pre>
    @if (len(section.notes) > 0)
    <ul>
        @foreach (note: string in section.notes)
        <li>{{ note }}</li>
        @endforeach
    </ul>
    @endif
</section>
