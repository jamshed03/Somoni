// The sections of the documentation site, read from the text files in content/.

export struct Section {
    id: string,
    title: string,
    intro: string,
    example: string,
    notes: list<string>
}

// Returns the text after `prefix` if `line` starts with it.
fn after(line: string, prefix: string): string? {
    if (line.starts_with(prefix)) {
        return line.slice(len(prefix), len(line));
    }
    return null;
}

// Reads a section from its text: lines "title: ", "intro: " and "note: ", then "---" and the example.
export fn parse_section(id: string, text: string): result<Section, string> {
    var title = "";
    var intro = "";
    var notes: list<string> = [];
    var example: list<string> = [];
    var in_example = false;
    for (line: string in text.split("\n")) {
        if (in_example) {
            example += [line];
        } else if (line == "---") {
            in_example = true;
        } else if (var value = after(line, "title: ")) {
            title = value;
        } else if (var value = after(line, "intro: ")) {
            intro = value;
        } else if (var value = after(line, "note: ")) {
            notes += [value];
        } else if (line.trim() != "") {
            return err("{id}: unknown line '{line}'");
        }
    }
    if (title == "") {
        return err("{id}: the line 'title: ' is missing");
    }
    return ok(Section {
        id: id,
        title: title,
        intro: intro,
        example: example.join("\n").trim(),
        notes: notes
    });
}

// Reads the section `id` from content/`id`.txt.
export fn load_section(id: string): result<Section, string> {
    var text = read_file("../content/{id}.txt")?;
    return parse_section(id, text);
}
