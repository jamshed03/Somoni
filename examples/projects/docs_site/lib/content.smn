// The sections of the documentation site, read from the Markdown files in content/.

import { inline, to_html } from "markdown.smn";

export struct Section {
    id: string,
    title: string,
    // The first paragraph as HTML, also shown on the start page.
    intro: string,
    // Everything after the title as HTML.
    html: string
}

// Returns the first paragraph of `lines`: the lines up to the first empty one after some text.
fn first_paragraph(lines: list<string>): string {
    var paragraph: list<string> = [];
    for (line: string in lines) {
        if (line.trim() != "") {
            paragraph += [line.trim()];
        } else if (len(paragraph) > 0) {
            break;
        }
    }
    return paragraph.join(" ");
}

// Reads a section from its Markdown: the title in the first line `# title`, then the text.
export fn parse_section(id: string, text: string): result<Section, string> {
    var lines = text.split("\n");
    if (len(lines) == 0 || !lines[0].starts_with("# ")) {
        return err("{id}: the first line must be the title, like '# Modules'");
    }
    var body = lines.slice(1, len(lines));
    return ok(Section {
        id: id,
        title: lines[0].slice(2, len(lines[0])).trim(),
        intro: inline(first_paragraph(body)),
        html: to_html(body.join("\n"))
    });
}

// Reads the section `id` from content/`id`.md.
export fn load_section(id: string): result<Section, string> {
    var text = read_file("../content/{id}.md")?;
    return parse_section(id, text);
}
