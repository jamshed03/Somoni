// Checks saving a game in SQLite and going on with it later, in a database in memory, and broken saved data.

import { Shape } from "lib/domain/shape.smn";
import { Board } from "lib/domain/board.smn";
import { PieceFactory } from "lib/domain/piece_factory.smn";
import { Game } from "lib/domain/game.smn";
import { Command, GameService } from "lib/ports/game_service.smn";
import { FixedPieces } from "lib/adapters/fixed_pieces.smn";
import { SqliteGames } from "lib/adapters/sqlite_games.smn";
import { TextView } from "lib/adapters/text_view.smn";

// Plays until a turned T falls, saves the game, loads it into a new one and goes on with it.
fn check(db: database): result<int, string> {
    var store = new SqliteGames(db);
    var view = new TextView();
    print(store.load());

    var factory = new PieceFactory(4);
    var service = new GameService(new Game(Board::empty(4, 6), factory), new FixedPieces([Shape.I, Shape.O, Shape.T]));
    for (command in [Command.Drop, Command.Left, Command.Drop, Command.Down, Command.Rotate]) {
        service.apply(command);
    }
    print(store.save(service.game().snapshot()));

    if (var snapshot = store.load()?) {
        var restored = Game::restore(snapshot, factory);
        print(view.show(restored) == view.show(service.game()));
        print(view.show(restored));
        var going_on = new GameService(restored, new FixedPieces([Shape.I]));
        going_on.apply(Command.Drop);
        print(view.show(going_on.game()));
        print(store.save(going_on.game().snapshot()));
    }
    var rows = db.fetch("SELECT count(*) AS n FROM games", [])?;
    print(rows[0].get_int("n"));

    db.execute("UPDATE games SET board = ?", ["../X."])?;
    print(store.load());
    db.execute("UPDATE games SET board = ?, piece = ?", ("..../....", "T 2"))?;
    print(store.load());
    return ok(0);
}

match (db_open(":memory:")) {
    ok(db: database) => {
        print(check(db));
    }
    err(reason: string) => {
        print(reason);
    }
}
