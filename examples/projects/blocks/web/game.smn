// The controller for the browser: GET /game gives the state of the game as JSON, POST /game with command=left,
// right, rotate, down, drop or new runs it first. It is also the composition root: it picks the adapters and
// connects the listener that saves the score when a game ends.

import { Board } from "../lib/domain/board.smn";
import { PieceFactory } from "../lib/domain/piece_factory.smn";
import { Game } from "../lib/domain/game.smn";
import { Command, GameService } from "../lib/ports/game_service.smn";
import { HighscoreRecorder } from "../lib/ports/highscore_recorder.smn";
import { RandomPieces } from "../lib/adapters/random_pieces.smn";
import { SqliteGames } from "../lib/adapters/sqlite_games.smn";
import { SqliteScores } from "../lib/adapters/sqlite_scores.smn";
import { JsonView, json_string } from "../lib/adapters/json_view.smn";

const WIDTH = 10;
const HEIGHT = 20;

// Returns the command for its name from the request, or null for an unknown one; "new" is handled before.
fn command_for(name: string): Command? {
    match (name) {
        "left" => {
            return Command.Left;
        }
        "right" => {
            return Command.Right;
        }
        "rotate" => {
            return Command.Rotate;
        }
        "down" => {
            return Command.Down;
        }
        "drop" => {
            return Command.Drop;
        }
        _ => {
            return null;
        }
    }
}

// Answers with an error as JSON and its status.
fn fail(status: int, message: string): void {
    set_status(status);
    print("\{\"error\":{json_string(message)}\}");
}

// Loads the saved game (or starts a new one for "new"), runs the command, saves the game and returns its JSON;
// the listener is connected before the service, since already its first piece can end the game.
fn answer(db: database, name: string?): result<string, string> {
    var store = new SqliteGames(db);
    var factory = new PieceFactory(WIDTH);
    var game = new Game(Board::empty(WIDTH, HEIGHT), factory);
    if (var snapshot = store.load()?) {
        if (name != "new") {
            game = Game::restore(snapshot, factory);
        }
    }
    var recorder = new HighscoreRecorder(new SqliteScores(db));
    game.subscribe(recorder);
    var service = new GameService(game, new RandomPieces());
    if (var text = name) {
        if (var command = command_for(text)) {
            service.apply(command);
        }
    }
    if (var problem = recorder.error()) {
        return err("cannot save the score: {problem}");
    }
    store.save(service.game().snapshot())?;
    return ok(new JsonView().show(service.game()));
}

// Answers one request: 400 for an unknown command, 500 if the database fails, else the state of the game.
fn handle(): void {
    var name = form("command");
    if (var text = name) {
        if (text != "new" && command_for(text) == null) {
            fail(400, "unknown command '{text}'");
            return;
        }
    }
    match (db_open("data/blocks.db")) {
        ok(db: database) => {
            match (answer(db, name)) {
                ok(json: string) => {
                    print(json);
                }
                err(reason: string) => {
                    fail(500, reason);
                }
            }
        }
        err(reason: string) => {
            fail(500, reason);
        }
    }
}

if (request_method() == "") {
    print("This page answers the browser; start it with: somoni serve examples/projects/blocks/web");
} else {
    handle();
}
