// Plays the game in the terminal: type keys, then Enter; after every line the piece falls one row.
// a left, d right, w turn, s down, space drop, q quit. `somoni terminal.smn demo` uses a fixed order of shapes.

import { Shape } from "lib/domain/shape.smn";
import { Board } from "lib/domain/board.smn";
import { PieceFactory } from "lib/domain/piece_factory.smn";
import { Game } from "lib/domain/game.smn";
import { Command, GameService } from "lib/ports/game_service.smn";
import { PieceSource } from "lib/ports/piece_source.smn";
import { GameView } from "lib/ports/game_view.smn";
import { FixedPieces } from "lib/adapters/fixed_pieces.smn";
import { RandomPieces } from "lib/adapters/random_pieces.smn";
import { TextView } from "lib/adapters/text_view.smn";

const WIDTH = 10;
const HEIGHT = 20;

// Returns the source of shapes: a fixed order with the argument `demo`, else chance.
fn pieces(): PieceSource {
    if (args().contains("demo")) {
        return new FixedPieces([Shape.I, Shape.O, Shape.T, Shape.S, Shape.Z, Shape.J, Shape.L]);
    }
    return new RandomPieces();
}

// Returns the command for a key, or null for a key that means nothing.
fn command_for(key: string): Command? {
    match (key) {
        "a" => {
            return Command.Left;
        }
        "d" => {
            return Command.Right;
        }
        "w" => {
            return Command.Rotate;
        }
        "s" => {
            return Command.Down;
        }
        " " => {
            return Command.Drop;
        }
        _ => {
            return null;
        }
    }
}

var service = new GameService(new Game(Board::empty(WIDTH, HEIGHT), new PieceFactory(WIDTH)), pieces());
var view: GameView = new TextView();
print(view.show(service.game()));
while (var line = input()) {
    if (line.contains("q")) {
        break;
    }
    for (key in line) {
        if (var command = command_for(key)) {
            service.apply(command);
        }
    }
    service.apply(Command.Down);
    print(view.show(service.game()));
    if (service.game().is_over()) {
        break;
    }
}
print("final score: {service.game().score()}");
