// Keeps the running game in SQLite, one row with a column for each part; reading a row back is the DTO mapping.

import { Shape, shape_from_letter, shape_letter } from "../domain/shape.smn";
import { Cell, Piece } from "../domain/piece.smn";
import { Board } from "../domain/board.smn";
import { GameSnapshot } from "../domain/snapshot.smn";
import { GameStore } from "../ports/game_store.smn";

// Saves the game in the table `games` of a database it gets from outside.
export class SqliteGames implements GameStore {
    private db: database;

    constructor(db: database) {
        this.db = db;
    }

    load(): result<GameSnapshot?, string> {
        this.make_table()?;
        var rows = this.db.fetch("SELECT score, over, piece, board FROM games WHERE id = 1", [])?;
        if (len(rows) == 0) {
            return ok(null);
        }
        var row = rows[0];
        var piece: Piece? = null;
        if (!row.is_null("piece")?) {
            piece = parse_piece(row.get_string("piece")?)?;
        }
        var board = parse_board(row.get_string("board")?)?;
        return ok(GameSnapshot { board: board, piece: piece, score: row.get_int("score")?, over: row.get_bool("over")? });
    }

    save(snapshot: GameSnapshot): result<int, string> {
        this.make_table()?;
        var piece: string? = null;
        if (var falling = snapshot.piece) {
            piece = piece_text(falling);
        }
        var sql = "INSERT OR REPLACE INTO games (id, score, over, piece, board) VALUES (1, ?, ?, ?, ?)";
        return this.db.execute(sql, (snapshot.score, snapshot.over, piece, board_text(snapshot.board)));
    }

    // Makes the table on first use.
    private make_table(): result<int, string> {
        var sql = "CREATE TABLE IF NOT EXISTS games "
            + "(id INTEGER PRIMARY KEY, score INTEGER NOT NULL, over INTEGER NOT NULL, piece TEXT, board TEXT NOT NULL)";
        return this.db.execute(sql, []);
    }
}

// Returns the board as text: its rows joined by /, . for an empty cell and the letter of a shape for a taken one.
fn board_text(board: Board): string {
    var rows: list<string> = [];
    for (var row = 0; row < board.height; row += 1) {
        var line = "";
        for (var col = 0; col < board.width; col += 1) {
            if (var shape = board.shape_at(row, col)) {
                line += shape_letter(shape);
            } else {
                line += ".";
            }
        }
        rows += [line];
    }
    return rows.join("/");
}

// Returns the board from its text, or an error if a row has another width or an unknown letter.
fn parse_board(text: string): result<Board, string> {
    var lines = text.split("/");
    var width = len(lines[0]);
    var rows: list<list<Shape?>> = [];
    for (line in lines) {
        if (len(line) != width) {
            return err("the rows of the saved board have different widths");
        }
        var row: list<Shape?> = [];
        for (letter in line) {
            if (letter == ".") {
                row += [null];
            } else if (var shape = shape_from_letter(letter)) {
                row += [shape];
            } else {
                return err("unknown shape '{letter}' in the saved board");
            }
        }
        rows += [row];
    }
    return ok(new Board(width, len(lines), rows));
}

// Returns the piece as text: its letter, row, column and the four offsets that also tell how it is turned.
fn piece_text(piece: Piece): string {
    var offsets = piece.offsets().map(fn(cell) => "{cell.row},{cell.col}");
    return "{shape_letter(piece.shape)} {piece.row} {piece.col} {offsets.join(";")}";
}

// Returns the piece from its text, or an error if a part is missing or not a number.
fn parse_piece(text: string): result<Piece, string> {
    var parts = text.split(" ");
    if (len(parts) != 4) {
        return err("the saved piece '{text}' does not have four parts");
    }
    var shape = shape_from_letter(parts[0]);
    if (shape == null) {
        return err("unknown shape '{parts[0]}' in the saved piece");
    }
    var offsets: list<Cell> = [];
    for (pair in parts[3].split(";")) {
        var numbers = pair.split(",");
        if (len(numbers) != 2) {
            return err("the offset '{pair}' of the saved piece is not row,col");
        }
        offsets += [Cell { row: int(numbers[0])?, col: int(numbers[1])? }];
    }
    return ok(new Piece(shape, int(parts[1])?, int(parts[2])?, offsets));
}
