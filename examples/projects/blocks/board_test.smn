// Checks the board on a small well of 4 × 4: where pieces fit, placing them and clearing full rows.

import { Shape } from "lib/domain/shape.smn";
import { Board } from "lib/domain/board.smn";
import { PieceFactory } from "lib/domain/piece_factory.smn";

// Prints the board: # for a taken cell, . for an empty one, and a line after it.
fn draw(board: Board): void {
    for (var row = 0; row < board.height; row += 1) {
        var line = "";
        for (var col = 0; col < board.width; col += 1) {
            if (board.shape_at(row, col) != null) {
                line += "#";
            } else {
                line += ".";
            }
        }
        print(line);
    }
    print("--");
}

var factory = new PieceFactory(4);
var empty = Board::empty(4, 4);
var bar = factory.create(Shape.I);
var square = factory.create(Shape.O);

print("fits: start, floor, below, right, left");
print(empty.fits(bar));
print(empty.fits(bar.moved(3, 0)));
print(empty.fits(bar.moved(4, 0)));
print(empty.fits(bar.moved(0, 1)));
print(empty.fits(bar.moved(0, -1)));

print("a full row goes away");
var full = empty.placed(bar.moved(3, 0));
draw(full);
var (after, rows) = full.cleared();
draw(after);
print(rows);

print("two squares fill two rows");
var left = empty.placed(square.moved(2, -1));
draw(left);
print(left.fits(square.moved(2, -1)));
var both = left.placed(square.moved(2, 1));
var (cleared, two) = both.cleared();
draw(cleared);
print(two);

print("rows above a cleared row move down");
var stacked = empty.placed(square.moved(0, -1)).placed(bar.moved(2, 0));
draw(stacked);
var (moved, one) = stacked.cleared();
draw(moved);
print(one);
print(moved.shape_at(1, 0));
print(moved.shape_at(9, 9));
