// passes a big string (10000 characters) 100000 times to a function:
// measures what reading and passing a value costs
var text: string = "";
for (var i: int = 0; i < 10000; i = i + 1) {
    text = text + "x";
}

fn size(t: string): int {
    return len(t);
}

var total: int = 0;
for (var i: int = 0; i < 100000; i = i + 1) {
    total = total + size(text);
}
print(total);
