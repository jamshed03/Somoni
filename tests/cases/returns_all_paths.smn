fn amount(n: int): int {
    if (n < 0) {
        return -n;
    } else {
        return n;
    }
}

fn grade(points: int): string {
    if (points >= 90) {
        return "very good";
    } else if (points >= 50) {
        return "passed";
    } else {
        return "failed";
    }
}

fn in_block(): int {
    {
        return 7;
    }
}

fn void_without_return(): void {
    print("void needs no return");
}

print(amount(-4));
print(amount(4));
print(grade(95));
print(grade(60));
print(grade(10));
print(in_block());
void_without_return();
