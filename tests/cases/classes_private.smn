class User {
    public name: string;
    private password: string;
    private attempts: int = 0;

    public constructor(name: string, password: string) {
        this.name = name;
        this.password = password;
    }

    public login(entered: string): bool {
        this.count();
        return this.password == entered;
    }

    private count(): void {
        this.attempts += 1;
    }

    // private works for other objects of the same class too
    samePassword(other: User): bool {
        return this.password == other.password;
    }

    attemptsSoFar(): int {
        return this.attempts;
    }
}

var u: User = new User("Ali", "secret");
print(u.login("wrong"));
print(u.login("secret"));
print(u.attemptsSoFar());
print(u.samePassword(new User("Sara", "secret")));

// public fields can be changed from outside
u.name = "Ali B.";
// print shows private fields too
print(u);
