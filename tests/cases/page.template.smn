{{-- A template: HTML text with {{ }} (escaped), {!! !!} (raw) and comments like this one --}}
<!doctype html>
<html lang="de">
<head>
    <title>{{ "Somoni & Templates" }}</title>
</head>
<body>
    <h1>{{ "<Willkommen>" }}</h1>
    <p>{{ 6 * 7 }} ist die Antwort, {{ 2.5 }} ist ein float, {{ true }} ein bool.</p>
    <p>{{ "a,b,c".split(",").join(" | ") }} und {{ {"k": "Map"}["k"] }}</p>
    {!! "<em>roh, nicht escaped</em>" !!}
    <p>E-Mail: info@somoni.dev, CSS: a { color: red; }, einzelne } bleiben</p>
    <p>{{ "verschachtelt {"in" + "nen"} }}" }}</p>
</body>
</html>
