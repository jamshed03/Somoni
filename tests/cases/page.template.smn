{{-- A template: HTML text with {{ }} (escaped), {!! !!} (raw) and comments like this one --}}
<!doctype html>
<html lang="en">
<head>
    <title>{{ "Somoni & Templates" }}</title>
</head>
<body>
    <h1>{{ "<Welcome>" }}</h1>
    <p>{{ 6 * 7 }} is a Answer, {{ 2.5 }} is a float, {{ true }} a bool.</p>
    <p>{{ "a,b,c".split(",").join(" | ") }} and {{ {"k": "Map"}["k"] }}</p>
    {!! "<em>raw, not escaped</em>" !!}
    <p>E-Mail: info@somoni.dev, CSS: a { color: red; }, single } stay</p>
    <p>{{ "nested {"in" + "ner"} }}" }}</p>
</body>
</html>
