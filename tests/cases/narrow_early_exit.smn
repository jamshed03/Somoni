// after an if whose branch always leaves the block, the opposite of its condition holds
class Node {
    wert: int;
    next: Node?;

    constructor(wert: int, next: Node?) {
        this.wert = wert;
        this.next = next;
    }
}

fn sum(n: Node?): int {
    if (n == null) {
        return 0;
    }
    return n.wert + sum(n.next);
}

fn first(l: list<int?>): int {
    for (x: int? in l) {
        if (x == null) {
            continue;
        }
        return x * 10;
    }
    return -1;
}

fn bis_null(l: list<int?>): int {
    var outcome: int = 0;
    for (x: int? in l) {
        if (x != null) {
            print("found");
        } else {
            break;
        }
        outcome += x;
    }
    return outcome;
}

fn with_block(a: int?): int {
    if (a == null) {
        print("empty");
        return 0;
    }
    return a + 1;
}

print(sum(new Node(1, new Node(2, null))));
print(first([null, null, 4]));
print(bis_null([1, 2, null, 5]));
print(with_block(null));
print(with_block(41));
