// several values or variants in one branch of match, joined with |
enum Color {
    Red,
    Green,
    Blue,
    Yellow
}

fn warm(f: Color): bool {
    match (f) {
        Color.Red | Color.Yellow => {
            return true;
        }
        Color.Green | Color.Blue => {
            return false;
        }
    }
}

fn species(c: string): string {
    match (c) {
        "a" | "e" | "i" | "o" | "u" => {
            return "Vowel";
        }
        " " => {
            return "Empty";
        }
        _ => {
            return "other";
        }
    }
}

fn tag(n: int): string {
    match (n) {
        6 | 7 => {
            return "Weekend";
        }
        _ => {
            return "Weekday";
        }
    }
}

print(warm(Color.Red));
print(warm(Color.Blue));
print(warm(Color.Yellow));
print(species("e"));
print(species(" "));
print(species("x"));
print(tag(7));
print(tag(3));

match (Color.Green) {
    Color.Red | Color.Blue => {
        print("red or blue");
    }
    _ => {
        print("something other");
    }
}
