// m.get(key, default) gives the value of a key, or the default if the map does not have it
var counts: map<string, int> = {};
for (word: string in "the dog and the bird and the".split(" ")) {
    counts[word] = counts.get(word, 0) + 1;
}
print(counts);
print(counts.get("the", 0));
print(counts.get("cat", 0));
print(len(counts));

var names: map<int, string> = {1: "Ali"};
print(names.get(1, "?"));
print(names.get(2, "?"));

var empty: list<int> = [];
var groups: map<string, list<int>> = {"a": [1, 2]};
print(groups.get("a", empty));
print(groups.get("b", empty));
