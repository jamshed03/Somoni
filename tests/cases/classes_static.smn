// static methods with Class::name(), private and protected constructors
class Counter {
    value: int;

    private constructor(start: int) {
        this.value = start;
    }

    static fresh(): Counter {
        return new Counter(0);
    }

    static starting_at(start: int): Counter {
        return Counter::verify(start);
    }

    private static verify(start: int): Counter {
        if (start < 0) {
            return new Counter(0);
        }
        return new Counter(start);
    }

    increase(): void {
        this.value += 1;
    }

    copy(): Counter {
        return Counter::starting_at(this.value);
    }
}

class Math {
    static square(x: int): int {
        return x * x;
    }
}

class Animal {
    name: string;

    protected constructor(name: string) {
        this.name = name;
    }
}

class Dog extends Animal {
    constructor() {
        super("Bello");
    }

    static puppy(): Dog {
        return new Dog();
    }
}

var z: Counter = Counter::fresh();
z.increase();
print(z.value);
print(Counter::starting_at(-5).value);
print(Counter::starting_at(7).copy().value);
print(Math::square(4));
Math::square(2);
print(Dog::puppy().name);
