// static methods with Class::name(), private and protected constructors
class Counter {
    wert: int;

    private constructor(start: int) {
        this.wert = start;
    }

    static fresh(): Counter {
        return new Counter(0);
    }

    static ab(start: int): Counter {
        return Counter::verify(start);
    }

    private static verify(start: int): Counter {
        if (start < 0) {
            return new Counter(0);
        }
        return new Counter(start);
    }

    increase(): void {
        this.wert += 1;
    }

    copy(): Counter {
        return Counter::ab(this.wert);
    }
}

class Math {
    static quadrat(x: int): int {
        return x * x;
    }
}

class Animal {
    name: string;

    protected constructor(name: string) {
        this.name = name;
    }
}

class Dog extends Animal {
    constructor() {
        super("Bello");
    }

    static puppy(): Dog {
        return new Dog();
    }
}

var z: Counter = Counter::fresh();
z.increase();
print(z.wert);
print(Counter::ab(-5).wert);
print(Counter::ab(7).copy().wert);
print(Math::quadrat(4));
Math::quadrat(2);
print(Dog::puppy().name);
