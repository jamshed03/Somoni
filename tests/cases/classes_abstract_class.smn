// an abstract class has no objects of its own, only its subclasses do
abstract class Form {
    name: string;

    constructor(name: string) {
        this.name = name;
    }

    description(): string {
        return "Form " + this.name;
    }

    static unit(): string {
        return "cm";
    }
}

class Quadrat extends Form {
    side: int;

    constructor(side: int) {
        super("Quadrat");
        this.side = side;
    }
}

var f: Form = new Quadrat(3);
print(f.description());
print(Form::unit());
