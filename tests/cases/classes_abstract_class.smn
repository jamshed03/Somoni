// an abstract class has no objects of its own, only its subclasses do
abstract class Shape {
    name: string;

    constructor(name: string) {
        this.name = name;
    }

    description(): string {
        return "Shape " + this.name;
    }

    static unit(): string {
        return "cm";
    }
}

class Square extends Shape {
    side: int;

    constructor(side: int) {
        super("Square");
        this.side = side;
    }
}

var f: Shape = new Square(3);
print(f.description());
print(Shape::unit());
