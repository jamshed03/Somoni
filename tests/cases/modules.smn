import { quadrat, Point, move, Direction, secret } from "modules/math.smn";
import { brackets } from "modules/text/brackets.smn";

print(quadrat(4));
var p: Point = Point { x: 1, y: 2 };
p = move(p, 3);
print(p);
match (Direction.Right) {
    Direction.Links => {
        print("links");
    }
    Direction.Right => {
        print("right");
    }
}

// numbers.smn is imported by two files and loaded once
print(brackets("a"));

// a private struct can be passed on, but not named here
print(secret());
print(secret() == secret());

// own names may be the same as private names in math.smn
fn times(a: int): int {
    return a + 100;
}
print(times(5));
struct Secret {
    text: string
}
print(Secret { text: "mine" });

// export in the main file is allowed and changes nothing
export fn hello(): string {
    return "hello";
}
print(hello());
