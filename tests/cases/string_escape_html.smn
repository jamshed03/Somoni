// s.escape_html() makes text safe for HTML: & < > " and ' become entities
print("<b>Tom & Jerry</b>".escape_html());
print("He said \"Hello\" and 'Bye, Zoë'".escape_html());
print("&amp; is escaped again".escape_html());
print("without special Characters".escape_html());
print("".escape_html() == "");

var name = "<script>alert(1)</script>";
print("<p>Hello {name.escape_html()}</p>");
print("<a href=\"{"/search?a=1&b=2".escape_html()}\">Search</a>");
