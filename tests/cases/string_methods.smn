// split, join, contains, starts_with, ends_with, replace, slice and index_of on strings
var line: string = "Ali,Bea,,Cem";
var parts: list<string> = line.split(",");
print(parts);
print(len(parts));
print(parts.join(" / "));
print("abc".split(""));
print(["x"].join("-"));
var empty: list<string> = [];
print(empty.join(",") == "");

print("Hello World".contains("lo W"));
print("Hello".contains("x"));
print("Hello".starts_with("He"));
print("Hello".ends_with("lo"));
print("Hello".ends_with("La"));

print("a-b-c".replace("-", " + "));
print("aaa".replace("a", "bb"));
print("abc".replace("", "x"));

print("Crème".slice(1, 4));
print("abc".slice(0, 0) == "");
print("abc".slice(0, 3));

print("Crème from Paris".index_of("from"));
print("abc".index_of("x"));
var place: int? = "abc".index_of("c");
if (place != null) {
    print(place + 1);
}

var csv: string = "  name ; age ";
for (field: string in csv.split(";")) {
    print("[" + field.trim().upper() + "]");
}
