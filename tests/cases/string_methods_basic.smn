// strings have methods like s.upper(); they return a new string and never change s
var name: string = "  Ali Baba ";
print(name.trim());
print(name.upper());
print(name.trim().lower());
print("äöü".upper());
print(name);

var names: list<string> = ["ali", "bea"];
print(names[1].upper());

fn upper(n: int): int {
    return n * 2;
}
print(upper(21));

const GRUSS: string = "hello";
print(GRUSS.upper());
