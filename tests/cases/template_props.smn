// a template with @props is a function: import it like one and call it with its data
import { Page } from "modules/pages.smn";
import { card as link } from "modules/card.template.smn";

var pages = [
    Page { title: "Start", url: "/" },
    Page { title: "Typen & Werte", url: "/typen?a=1&b=2" },
    Page { title: "<Templates>", url: "/templates" }
];
print("<ul>");
for (page: Page in pages) {
    link(page, page.title == "Start");
}
print("</ul>");
