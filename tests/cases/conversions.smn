print(int(3.9));          // cut off, not rounded
print(int(-3.9));
print(float(2) / 4.0);
print(string(42) + "!");
print(string(true));
print(string(2.5));
print(string(int(9.99)));
print(len("Somoni"));
print(len("ä"));          // characters, not bytes
print(len(""));
print(len(string(12345)));
len("unused");            // a call as a statement, the result is dropped
