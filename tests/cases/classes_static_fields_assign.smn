// static fields change with Class::name = value, also their parts
class Zaehler {
    static anzahl: int = 0;
    static namen: list<string> = ["a", "b"];
    static tabelle: map<string, int> = {"x": 1};
    static text: string = "";

    constructor(name: string) {
        Zaehler::anzahl += 1;
        Zaehler::text += name;
    }
}

class Konto {
    stand: int = 0;
}

class Bank {
    static konten: list<Konto> = [];
}

new Zaehler("A");
new Zaehler("B");
print(Zaehler::anzahl);
print(Zaehler::text);
Zaehler::anzahl = 10;
print(Zaehler::anzahl);
Zaehler::namen[0] = "z";
Zaehler::namen += ["c"];
print(Zaehler::namen);
Zaehler::tabelle["y"] = 2;
Zaehler::tabelle["x"] += 5;
print(Zaehler::tabelle);
var kopie: list<string> = Zaehler::namen;
kopie[0] = "k";
print(Zaehler::namen[0]);
Bank::konten += [new Konto()];
Bank::konten[0].stand = 5;
print(Bank::konten[0].stand);
