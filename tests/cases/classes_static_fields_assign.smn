// static fields change with Class::name = value, also their parts
class Counter {
    static quantity: int = 0;
    static names: list<string> = ["a", "b"];
    static table: map<string, int> = {"x": 1};
    static text: string = "";

    constructor(name: string) {
        Counter::quantity += 1;
        Counter::text += name;
    }
}

class Account {
    balance: int = 0;
}

class Bank {
    static accounts: list<Account> = [];
}

new Counter("A");
new Counter("B");
print(Counter::quantity);
print(Counter::text);
Counter::quantity = 10;
print(Counter::quantity);
Counter::names[0] = "z";
Counter::names += ["c"];
print(Counter::names);
Counter::table["y"] = 2;
Counter::table["x"] += 5;
print(Counter::table);
var copy: list<string> = Counter::names;
copy[0] = "k";
print(Counter::names[0]);
Bank::accounts += [new Account()];
Bank::accounts[0].balance = 5;
print(Bank::accounts[0].balance);
