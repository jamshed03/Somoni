// readonly fields: set in the constructor of their class, read everywhere,
// objects behind them stay changeable
class Account {
    balance: int = 0;
}

class Register {
    readonly prices: list<int>;
    readonly max: int = 10;
    private readonly name: string = "Register";
    readonly account: Account;
    readonly all: list<Account>;

    constructor(p: list<int>) {
        this.prices = p;
        this.max = 20;
        this.account = new Account();
        this.all = [new Account()];
        this.prices[0] = 5;
    }

    sum(): int {
        return this.prices[0] + this.prices[1] + this.max;
    }

    title(): string {
        return this.name;
    }
}

class Shop extends Register {
    constructor() {
        super([1, 1]);
    }

    doubled(): int {
        return this.max * 2;
    }
}

var k: Register = new Register([1, 2]);
print(k.prices);
print(k.max);
print(k.sum());
print(k.title());
k.account.balance = 7;
print(k.account.balance);
k.all[0].balance = 3;
print(k.all[0].balance);
const l: Shop = new Shop();
print(l.doubled());
