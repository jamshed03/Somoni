enum Color {
    Red,
    Green,
    Blue
}
var f: Color = Color.Green;
print(f);
print(f == Color.Green);
print(f != Color.Red);

// every branch returns, so the function returns on every path
fn name(f: Color): string {
    match (f) {
        Color.Red => {
            return "red";
        }
        Color.Green => {
            return "green";
        }
        Color.Blue => {
            return "blue";
        }
    }
}
for (c: Color in [Color.Red, Color.Green, Color.Blue]) {
    print(name(c));
}

// _ catches the rest
match (f) {
    Color.Red => {
        print("warm");
    }
    _ => {
        print("cold");
    }
}

// in structs and maps
struct Signal {
    color: Color,
    an: bool
}
var a: Signal = Signal { color: Color.Red, an: true };
print(a);
a.color = Color.Blue;
print(a.color);
var sky: map<string, Color> = {"Tag": Color.Blue};
print(sky);

// an enum used before its declaration; break inside a branch
fn reverse(r: Direction): Direction {
    match (r) {
        Direction.Links => {
            return Direction.Right;
        }
        Direction.Right => {
            return Direction.Links;
        }
    }
}
enum Direction {
    Links,
    Right
}
print(reverse(Direction.Links));
for (r: Direction in [Direction.Links, Direction.Right, Direction.Links]) {
    match (r) {
        Direction.Links => {
            print("<");
        }
        Direction.Right => {
            print(">");
            break;
        }
    }
}
