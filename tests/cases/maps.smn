var age: map<string, int> = {"Ali": 30, "Sara": 25};
print(age);
print(age["Sara"]);
print(age["Ali"] + 1);
print(len(age));

// has checks for a key before reading it
print(has(age, "Ali"));
print(has(age, "Tom"));
if (has(age, "Tom")) {
    print(age["Tom"]);
}

// keys in the order they were added
var names: list<string> = keys(age);
for (var i: int = 0; i < len(names); i = i + 1) {
    print(names[i] + ": " + string(age[names[i]]));
}

// int keys, list values, the empty map
var squares: map<int, list<int>> = {2: [4], 3: [9]};
print(squares);
print(squares[3][0]);
var empty: map<string, bool> = {};
print(empty);
print(len(empty));

// == does not care about the order
print(age == {"Sara": 25, "Ali": 30});
print(age == {"Ali": 30});
print(empty == {});

// a map in a struct and as a parameter
struct Team {
    name: string,
    goals: map<string, int>
}
var team: Team = Team { name: "Pamir", goals: {"Ali": 3} };
print(team);
fn total(goals: map<string, int>): int {
    var sum: int = 0;
    var players: list<string> = keys(goals);
    for (var i: int = 0; i < len(players); i = i + 1) {
        sum = sum + goals[players[i]];
    }
    return sum;
}
print(total({"Ali": 3, "Sara": 4}));
