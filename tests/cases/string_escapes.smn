// escape sequences in strings: \n new line, \t tab, \" quote, \\ backslash
print("one\ntwo");
print("Name:\tAli");
print("He said \"Hello\"");
print("C:\\temp\\new");
print(len("\n"));
print(len("\\"));
var lines: list<string> = "a\nb\nc".split("\n");
print(len(lines));
print(lines[2]);
print("one sentence
over two lines" == "one sentence\nover two lines");
print(["a\"b", "x\ny", "C:\\"]);
print({"tab": "a\tb"});
print(["a\{b\}"]);
print("a\{b\}");
print(len("a\r\nb"));
print(["a\r\nb"]);
print("x\ry" == "x" + "\r" + "y");
