// abstract methods have no body, every class that is not abstract overrides them
interface Named {
    name(): string;
}

abstract class Animal implements Named {
    abstract sound(): string;
    protected abstract legs(): int;

    description(): string {
        return this.name() + " says " + this.sound() + " on " + string(this.legs()) + " Legs";
    }

    name(): string {
        return "Animal";
    }
}

abstract class Quadruped extends Animal {
    protected override legs(): int {
        return 4;
    }
}

class Dog extends Quadruped {
    override sound(): string {
        return "Woof";
    }

    override name(): string {
        return "Dog";
    }
}

class Bird extends Animal {
    override sound(): string {
        return "Beep";
    }

    protected override legs(): int {
        return 2;
    }
}

var animals: list<Animal> = [new Dog(), new Bird()];
for (t: Animal in animals) {
    print(t.description());
}
var b: Named = new Dog();
print(b.name());
