import { Named } from "modules/named.smn";

interface Shape {
    area(): float;
    scale(factor: float): void;
}

class Circle implements Shape, Named {
    r: float;

    constructor(r: float) {
        this.r = r;
    }

    area(): float {
        return 3.0 * this.r * this.r;
    }

    scale(factor: float): void {
        this.r = this.r * factor;
    }

    name(): string {
        return "Circle";
    }
}

class Square implements Shape, Named {
    side: float;

    constructor(side: float) {
        this.side = side;
    }

    area(): float {
        return this.side * this.side;
    }

    scale(factor: float): void {
        this.side = this.side * factor;
    }

    name(): string {
        return "Square";
    }

    // more methods than the interface needs are fine
    perimeter(): float {
        return 4.0 * this.side;
    }
}

// the same call runs the method of the class of each object
var shapes: list<Shape> = [new Circle(1.0), new Square(2.0)];
for (f: Shape in shapes) {
    print(f.area());
}

// an interface as parameter and return type
fn sum(all: list<Shape>): float {
    var s: float = 0.0;
    for (f: Shape in all) {
        s = s + f.area();
    }
    return s;
}
print(sum(shapes));

fn larger(a: Shape, b: Shape): Shape {
    if (a.area() > b.area()) {
        return a;
    }
    return b;
}
var q: Square = new Square(3.0);
var g: Shape = larger(new Circle(1.0), q);
print(g);
print(g == q);

// a method through an interface changes the object (it is a reference)
for (f: Shape in shapes) {
    f.scale(2.0);
}
print(shapes);

// one class, two interfaces
var names: list<Named> = [new Circle(1.0), q];
for (n: Named in names) {
    print(n.name());
}
print(q.perimeter());

// an interface in a field and as optional
class Drawing {
    main: Shape? = null;
}
var z: Drawing = new Drawing();
z.main = new Circle(2.0);
print(z);
