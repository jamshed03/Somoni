import { Benannt } from "modules/benannt.smn";

interface Form {
    flaeche(): float;
    skalieren(faktor: float): void;
}

class Kreis implements Form, Benannt {
    r: float;

    constructor(r: float) {
        this.r = r;
    }

    flaeche(): float {
        return 3.0 * this.r * this.r;
    }

    skalieren(faktor: float): void {
        this.r = this.r * faktor;
    }

    name(): string {
        return "Kreis";
    }
}

class Quadrat implements Form, Benannt {
    seite: float;

    constructor(seite: float) {
        this.seite = seite;
    }

    flaeche(): float {
        return this.seite * this.seite;
    }

    skalieren(faktor: float): void {
        this.seite = this.seite * faktor;
    }

    name(): string {
        return "Quadrat";
    }

    // more methods than the interface needs are fine
    umfang(): float {
        return 4.0 * this.seite;
    }
}

// the same call runs the method of the class of each object
var formen: list<Form> = [new Kreis(1.0), new Quadrat(2.0)];
for (f: Form in formen) {
    print(f.flaeche());
}

// an interface as parameter and return type
fn summe(alle: list<Form>): float {
    var s: float = 0.0;
    for (f: Form in alle) {
        s = s + f.flaeche();
    }
    return s;
}
print(summe(formen));

fn groessere(a: Form, b: Form): Form {
    if (a.flaeche() > b.flaeche()) {
        return a;
    }
    return b;
}
var q: Quadrat = new Quadrat(3.0);
var g: Form = groessere(new Kreis(1.0), q);
print(g);
print(g == q);

// a method through an interface changes the object (it is a reference)
for (f: Form in formen) {
    f.skalieren(2.0);
}
print(formen);

// one class, two interfaces
var namen: list<Benannt> = [new Kreis(1.0), q];
for (n: Benannt in namen) {
    print(n.name());
}
print(q.umfang());

// an interface in a field and as optional
class Zeichnung {
    haupt: Form? = null;
}
var z: Zeichnung = new Zeichnung();
z.haupt = new Kreis(2.0);
print(z);
