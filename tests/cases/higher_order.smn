// map, filter, reduce, any, all and sort_by call a function for the elements of a list
struct User {
    name: string,
    age: int
}

fn square(n: int): int {
    return n * n;
}

var numbers: list<int> = [3, 1, 4, 1, 5];
print(numbers.map(square));
print(numbers.map(fn(n: int): string => "#" + string(n)));
print(numbers.filter(fn(n: int): bool => n > 2));
print(numbers.reduce(0, fn(sum: int, n: int): int => sum + n));
print(numbers.reduce("", fn(text: string, n: int): string => text + string(n)));
print(numbers.any(fn(n: int): bool => n == 4));
print(numbers.all(fn(n: int): bool => n > 0));
print(numbers.all(fn(n: int): bool => n > 1));

var limit: int = 3;
print(numbers.filter(fn(n: int): bool => n >= limit).map(square));

var users: list<User> = [
    User { name: "Cem", age: 41 },
    User { name: "Ali", age: 30 },
    User { name: "Bea", age: 30 }
];
var nach_age: list<User> = users.sort_by(fn(u: User): int => u.age);
print(nach_age.map(fn(u: User): string => u.name));
print(users.sort_by(fn(u: User): string => u.name).map(fn(u: User): string => u.name));
print(users.sort_by(fn(u: User): int => u.age).reverse()[0].name);

var table: list<list<int>> = [[1, 2], [3]];
print(table.map(fn(line: list<int>): list<int> => line.map(fn(n: int): int => n * 10)));

var empty: list<int> = [];
print(empty.map(square));
print(empty.any(fn(n: int): bool => true));
print(empty.all(fn(n: int): bool => false));
print(empty.reduce(7, fn(a: int, n: int): int => a + n));

fn tally(n: int): bool {
    print("check " + string(n));
    return n > 2;
}
print([1, 5, 9].any(tally));
