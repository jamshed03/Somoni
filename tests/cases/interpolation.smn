// "Hello {name}" puts values into a string, turned into text like string(...)
struct User {
    name: string,
    age: int
}

var name = "Ali";
var count = 3;
var price = 2.5;
var done = false;
print("Hello {name}!");
print("{count} Numbers, {price} Euro, done: {done}");
print("{count + 1} is more, {price.format(2)} with two Places");

var user = User { name: "Bea", age: 30 };
print("{user.name} is {user.age}");

var ages = {"Ali": 30};
print("Ali is {ages.get("Ali", 0)}, Tom is {ages.get("Tom", 0)}");
print("Map inside the braces: { {"k": 1}["k"] }");
print("nested: {"inner {name}"}");
print("{name}{count}");
print("{name}");
print("\{ curly \} and } alone");

var maybe: int? = 7;
if (maybe != null) {
    print("Wert {maybe}");
}

var lines = ["a", "b"];
print("{len(lines)} Lines:
- {lines[0]}
- {lines[1]}");

fn greet(who: string): string {
    return "Good Tag, {who.upper()}";
}
print(greet("cem"));
var twice = fn(n: int) => "{n} times 2 is {n * 2}";
print(twice(21));
