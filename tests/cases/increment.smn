// i++ and i-- are short statements for i += 1 and i -= 1, also for parts and in a for step
struct Counter {
    n: int
}

class Statistics {
    static calls: int = 0;
}

var i: int = 5;
i++;
i++;
i--;
print(i);

var sum: int = 0;
for (var k: int = 0; k < 4; k++) {
    sum += k;
}
print(sum);

for (var k: int = 3; k > 0; k--) {
    print(k);
}

var l: list<int> = [10, 20];
l[1]++;
print(l);

var z: Counter = Counter { n: 0 };
z.n++;
z.n++;
print(z.n);

Statistics::calls++;
print(Statistics::calls);

var x: int = 3;
print(--x);
print(x - -1);
