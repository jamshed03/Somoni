import { Named } from "modules/named.smn";

class Animal implements Named {
    protected species: string;
    private secret: int = 7;

    constructor(species: string) {
        this.species = species;
    }

    sound(): string {
        return "...";
    }

    // calls sound() of the class of the object, also from here
    introduce(): string {
        return this.name() + " says " + this.sound();
    }

    name(): string {
        return this.species;
    }

    protected doubled(s: string): string {
        return s + s;
    }
}

class Dog extends Animal {
    nickname: string;

    constructor(nickname: string) {
        super("Dog");
        this.nickname = nickname;
    }

    override sound(): string {
        return this.doubled("woof");
    }

    override name(): string {
        return this.nickname + " the " + super.name();
    }
}

// no constructor: takes the one of Animal
class Cat extends Animal {
    life: int = 9;

    override sound(): string {
        return "meow";
    }
}

// more than one level
class Puppy extends Dog {
    override sound(): string {
        return "wi" + super.sound();
    }
}

var animals: list<Animal> = [new Dog("Rex"), new Cat("Cat"), new Puppy("Bello"), new Animal("Fish")];
for (t: Animal in animals) {
    print(t.introduce());
}

// print shows the fields of Animal first
print(animals[0]);
print(new Cat("Cat").life);

// a Dog fits where an Animal or an interface of Animal is wanted
var b: Named = new Puppy("Fips");
print(b.name());
var t: Animal = animals[2];
print(t == animals[2]);

// the order: start values and constructor of the parent first
fn display(s: string): string {
    print(s);
    return s;
}
class A {
    a: string = display("A: StartValues");

    constructor() {
        print("A: constructor");
    }
}
class B extends A {
    b: string = display("B: StartValues");

    constructor() {
        super();
        print("B: constructor");
    }
}
new B();
