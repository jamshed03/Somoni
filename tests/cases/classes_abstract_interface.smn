// an abstract class fulfils an interface with an abstract method, its subclass has the body
interface Form {
    area(): int;
}

abstract class Basis implements Form {
    abstract area(): int;

    doubled(): int {
        return this.area() * 2;
    }
}

class Quadrat extends Basis {
    side: int = 3;

    override area(): int {
        return this.side * this.side;
    }
}

var f: Form = new Quadrat();
print(f.area());
var b: Basis = new Quadrat();
print(b.doubled());
