// an abstract class fulfils an interface with an abstract method, its subclass has the body
interface Shape {
    area(): int;
}

abstract class Base implements Shape {
    abstract area(): int;

    doubled(): int {
        return this.area() * 2;
    }
}

class Square extends Base {
    side: int = 3;

    override area(): int {
        return this.side * this.side;
    }
}

var f: Shape = new Square();
print(f.area());
var b: Base = new Square();
print(b.doubled());
