class Account {
    owner: string;
    stand: int = 0;
    bookings: list<int> = [];

    constructor(owner: string) {
        this.owner = owner;
    }

    deposit(amount: int): void {
        this.stand += amount;
        this.bookings = this.bookings + [amount];
    }

    withdraw(amount: int): result<int, string> {
        if (amount > this.stand) {
            return err("not enough money");
        }
        this.deposit(-amount);
        return ok(this.stand);
    }

    description(): string {
        return this.owner + ": " + string(this.stand);
    }
}

var k: Account = new Account("Ali");
k.deposit(100);
print(k.description());
print(k.withdraw(30));
print(k.withdraw(500));
print(k.bookings);

// a method changes the object for every reference
var equal: Account = k;
equal.deposit(5);
print(k.stand);

// method calls inside expressions and on new
print(new Account("Sara").description());
print(len(k.description()) > 3);

// the constructor may call methods once all fields are set; recursion
class Counter {
    stand: int;

    constructor(start: int) {
        this.stand = start;
        this.further();
    }

    further(): void {
        this.stand += 1;
    }

    factorial(n: int): int {
        if (n <= 1) {
            return 1;
        }
        return n * this.factorial(n - 1);
    }
}
var z: Counter = new Counter(10);
print(z.stand);
print(z.factorial(5));

// objects in a list, changed in a loop
var accounts: list<Account> = [new Account("A"), new Account("B")];
for (x: Account in accounts) {
    x.deposit(1);
}
print(accounts[1].stand);
for (var i: int = 0; i < 3; z.further()) {
    i += 1;
}
print(z.stand);

// new as a statement runs the constructor
class Melder {
    constructor() {
        print("built");
    }
}
new Melder();
