// """...""" is a raw string: no escapes and no {...}, and the indentation of the closing """ goes away
print("""He said "Hello {name}" and \n stays""");

fn example(): string {
    return """
        class Circle {
            area(): float {
                return 3.14 * this.r * this.r;
            }
        }

        print("done");
        """;
}
print(example());
print(len("""
    abc
    """));
print("[" + """
    """ + "]");
print(["""a "b" c"""]);
var name = "Ali";
print("""{name}""" + " and {name}");
