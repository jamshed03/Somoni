// a lambda is a function without a name: fn(x: int): int => x * 2, or with a block body
fn apply(f: fn(int): int, n: int): int {
    return f(n);
}

fn all(numbers: list<int>, f: fn(int): int): list<int> {
    var outcome: list<int> = [];
    for (n: int in numbers) {
        outcome += [f(n)];
    }
    return outcome;
}

fn adder(): fn(int, int): int {
    return fn(a: int, b: int): int => a + b;
}

const TEN: int = 10;

var times2: fn(int): int = fn(x: int): int => x * 2;
print(times2(21));
print(apply(fn(x: int): int => x + 1, 41));
print(all([1, 2, 3], fn(x: int): int => x * x));
print(adder()(2, 3));

var bigger: fn(int, int): int = fn(a: int, b: int): int {
    if (a > b) {
        return a;
    }
    return b;
};
print(bigger(3, 7));

var greeting: fn(string): void = fn(name: string): void {
    print("Hello " + name);
};
greeting("Ali");

var plus_ten: fn(int): int = fn(x: int): int => x + TEN;
print(plus_ten(5));

var nested: fn(int): fn(int): int = fn(x: int): fn(int): int => fn(y: int): int => y * 3;
print(nested(0)(4));

var divide: fn(int, int): result<int, string> = fn(a: int, b: int): result<int, string> {
    if (b == 0) {
        return err("Division by 0");
    }
    return ok(a / b);
};
print(divide(10, 2));
print(divide(1, 0));
