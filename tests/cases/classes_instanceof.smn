// instanceof asks at runtime whether an object belongs to a class or interface
interface Shape {
    area(): int;
}

abstract class Animal {
}

class Dog extends Animal {
}

class Dachshund extends Dog {
}

class Cat extends Animal implements Shape {
    area(): int {
        return 1;
    }
}

var animals: list<Animal> = [new Dog(), new Dachshund(), new Cat()];
for (t: Animal in animals) {
    print(t instanceof Dog);
}
var d: Dachshund = new Dachshund();
print(d instanceof Animal);
var k: Animal = new Cat();
print(k instanceof Shape);
var h: Animal = new Dog();
print(h instanceof Shape);
var empty: Animal? = null;
print(empty instanceof Animal);
var f: Shape = new Cat();
print(f instanceof Cat);
print(h instanceof Dog && !(h instanceof Dachshund));
