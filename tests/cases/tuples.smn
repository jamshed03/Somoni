// a tuple holds a fixed number of values of fixed types, read with p.0, p.1, ...
fn divide(a: int, b: int): (int, int) {
    return (a / b, a % b);
}

fn min_max(numbers: list<int>): (int, int)? {
    if (len(numbers) == 0) {
        return null;
    }
    var small: int = numbers[0];
    var gross: int = numbers[0];
    for (n: int in numbers) {
        if (n < small) {
            small = n;
        }
        if (n > gross) {
            gross = n;
        }
    }
    return (small, gross);
}

struct Entry {
    name: string,
    position: (int, int)
}

var p: (int, string) = (1, "one");
print(p);
print(p.0 + 1);
print(p.1);

var outcome: (int, int) = divide(17, 5);
print(outcome.0);
print(outcome.1);

var pairs: list<(string, bool)> = [("a", true), ("b", false)];
for (paar: (string, bool) in pairs) {
    if (paar.1) {
        print(paar.0);
    }
}

print(min_max([3, 9, 1]));
print(min_max([]));

var empty: (int?, list<int>) = (null, []);
print(empty);

var e: Entry = Entry { name: "x", position: (2, 3) };
print(e.position.1);
print(e);

var deep: ((int, int), string) = ((1, 2), "z");
print((deep.0).1);

print((1, "a") == (1, "a"));
print((1, "a") != (1, "b"));

var copy: (int, string) = p;
p = (2, "two");
print(copy);
print(p);
