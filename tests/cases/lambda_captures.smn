// a lambda copies the outside variables it uses when it is made; later changes outside do not reach it
fn times(factor: int): fn(int): int {
    return fn(x: int): int => x * factor;
}

fn alle(numbers: list<int>, f: fn(int): int): list<int> {
    var outcome: list<int> = [];
    for (n: int in numbers) {
        outcome += [f(n)];
    }
    return outcome;
}

fn counter_entries(): list<fn(): int> {
    var fs: list<fn(): int> = [];
    for (var i: int = 0; i < 3; i = i + 1) {
        fs += [fn(): int => i * 10];
    }
    return fs;
}

fn adder(a: int): fn(int): fn(int): int {
    return fn(b: int): fn(int): int => fn(c: int): int => a + b + c;
}

class Account {
    stand: int;

    constructor(stand: int) {
        this.stand = stand;
    }

    deposit(amount: int): void {
        this.stand += amount;
    }

    later(amount: int): fn(): void {
        return fn(): void {
            this.deposit(amount);
        };
    }

    pointer(): fn(): int {
        return fn(): int => this.stand;
    }
}

var triple: fn(int): int = times(3);
print(triple(5));
print(alle([1, 2, 3], times(10)));

var n: int = 2;
var plus_n: fn(int): int = fn(x: int): int => x + n;
n = 100;
print(plus_n(1));

var name: string = "Ali";
var gruss: fn(): string = fn(): string {
    var text: string = "Hello " + name;
    return text + "!";
};
name = "Bea";
print(gruss());

for (f: fn(): int in counter_entries()) {
    print(f());
}

print(adder(1)(20)(300));

var k: Account = new Account(5);
var payout: fn(): void = k.later(10);
var stand: fn(): int = k.pointer();
payout();
payout();
print(stand());
print(k.stand);

var entries: list<int> = [1, 2];
var length: fn(): int = fn(): int => len(entries);
entries += [3];
print(length());
