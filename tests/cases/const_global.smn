// constants at the top level are visible in functions, methods and start values of fields
const MAX: int = 100;
const NAMES: list<string> = ["Ali", "Bea"];

fn check(x: int): bool {
    return x < MAX;
}

fn second(): string {
    return NAMES[1];
}

class Register {
    limit: int = MAX;

    full(n: int): bool {
        return n >= this.limit + SURCHARGE;
    }
}

const SURCHARGE: int = 5;

fn hidden(MAX: int): int {
    return MAX;
}

print(check(5));
print(check(200));
print(second());
var k: Register = new Register();
print(k.full(104));
print(k.full(105));
print(hidden(7));
print(MAX);
