class User {
    name: string;
    age: int;
    visits: int = 0;

    constructor(name: string, age: int) {
        // local work first, this only to set fields until all have a value
        var clean: int = age;
        if (clean < 0) {
            clean = 0;
        }
        this.name = name;
        this.age = clean;
        // now this may be used freely
        this.visits += 1;
        if (this.age > 60) {
            return;
        }
        this.visits += 10;
    }
}

var u: User = new User("Ali", 30);
print(u);
print(new User("Grandpa", 70));
print(new User("Neg", -5).age);
print(new User("A", 1) == new User("A", 1));

// objects as arguments are references
class Team {
    chef: User;
    members: list<User> = [];

    constructor(chef: User) {
        this.chef = chef;
        this.members = [chef];
    }
}
var t: Team = new Team(u);
u.visits = 99;
print(t.chef.visits);
print(t.members[0] == u);

// new inside a constructor
class Paar {
    links: User;
    right: User;

    constructor(name: string) {
        this.links = new User(name, 1);
        this.right = new User(name, 2);
    }
}
print(new Paar("x").right.age);

// a class without fields and without constructor
class Empty {
}
print(new Empty());
