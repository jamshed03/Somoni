// var (a: int, b: string) = tuple; gives every element its own variable
fn divide(a: int, b: int): (int, int) {
    return (a / b, a % b);
}

fn display(): string {
    return NAME + " is " + string(AGE);
}

const (NAME: string, AGE: int) = ("Ali", 30);

var (q: int, r: int) = divide(17, 5);
print(q);
print(r);
q = q * 10;
print(q);

print(display());

var (number: int?, entries: list<int>) = (null, [1]);
print(number);
print(entries);

{
    var (q: int, r: string) = (1, "inner");
    print(r);
}
print(q);

var (a: int, b: int) = (1, 2);
var (x: int, y: int) = (3, 4);
print(a + b + x + y);
