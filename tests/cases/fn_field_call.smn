// a field with a function type is called like a method: k.action(x)
fn display(text: string): void {
    print("> " + text);
}

fn sound(text: string): void {
    print(text + "!");
}

fn double(n: int): int {
    return n * 2;
}

struct Button {
    name: string,
    action: fn(string): void
}

class Counter {
    stand: int;
    step: fn(int): int;

    constructor(step: fn(int): int) {
        this.stand = 1;
        this.step = step;
    }

    further(): int {
        this.stand = this.step(this.stand);
        return this.stand;
    }
}

var k: Button = Button { name: "ok", action: display };
k.action(k.name);
k.action = sound;
k.action(k.name);
var buttons: list<Button> = [k, Button { name: "no", action: display }];
buttons[1].action(buttons[1].name);
var z: Counter = new Counter(double);
z.further();
print(z.further());
print(z.step(10));
