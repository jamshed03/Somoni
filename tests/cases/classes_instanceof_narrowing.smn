// where instanceof is true, the variable has the narrower type
interface Shape {
    area(): int;
}

abstract class Animal {
    abstract sound(): string;
}

class Dog extends Animal {
    override sound(): string {
        return "Woof";
    }

    bark(): string {
        return "Woof woof";
    }
}

class Cat extends Animal implements Shape {
    override sound(): string {
        return "Meow";
    }

    area(): int {
        return 2;
    }
}

fn describe(t: Animal?): string {
    if (t instanceof Dog) {
        return t.bark();
    }
    if (t instanceof Shape) {
        return "Area " + string(t.area());
    }
    if (t != null) {
        return t.sound();
    }
    return "nothing";
}

print(describe(new Dog()));
print(describe(new Cat()));
print(describe(null));
var animals: list<Animal> = [new Dog(), new Cat()];
for (t: Animal in animals) {
    if (!(t instanceof Dog)) {
        print("no dog: " + t.sound());
    } else {
        print(t.bark());
    }
}
var h: Animal = new Dog();
print(h instanceof Dog && h.bark() == "Woof woof");
var k: Cat = new Cat();
if (k instanceof Shape) {
    print(k.sound());
}
