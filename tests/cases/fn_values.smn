// own functions are values of type fn(...): ..., they can be stored, passed on and called
fn square(n: int): int {
    return n * n;
}

fn doubled(n: int): int {
    return n * 2;
}

fn apply(f: fn(int): int, n: int): int {
    return f(n);
}

fn choose(big: bool): fn(int): int {
    if (big) {
        return square;
    }
    return doubled;
}

fn all(fs: list<fn(int): int>, n: int): list<int> {
    var outcomes: list<int> = [];
    for (f: fn(int): int in fs) {
        outcomes += [f(n)];
    }
    return outcomes;
}

var f: fn(int): int = square;
print(f(3));
f = doubled;
print(f(3));
print(apply(square, 4));
print(choose(true)(5));
print(choose(false)(5));
var fs: list<fn(int): int> = [square, doubled];
print(fs[1](10));
print(all(fs, 7));
var empty: fn(): void = fn_without;
empty();

fn fn_without(): void {
    print("without Parameter");
}

fn notifier(): fn(): void {
    return fn_without;
}

notifier()();

{
    var square: fn(int): int = doubled;
    print(square(6));
}
print(square(6));
