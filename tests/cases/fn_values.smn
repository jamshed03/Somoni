// own functions are values of type fn(...): ..., they can be stored, passed on and called
fn quadrat(n: int): int {
    return n * n;
}

fn doubled(n: int): int {
    return n * 2;
}

fn apply(f: fn(int): int, n: int): int {
    return f(n);
}

fn choose(gross: bool): fn(int): int {
    if (gross) {
        return quadrat;
    }
    return doubled;
}

fn alle(fs: list<fn(int): int>, n: int): list<int> {
    var outcomes: list<int> = [];
    for (f: fn(int): int in fs) {
        outcomes += [f(n)];
    }
    return outcomes;
}

var f: fn(int): int = quadrat;
print(f(3));
f = doubled;
print(f(3));
print(apply(quadrat, 4));
print(choose(true)(5));
print(choose(false)(5));
var fs: list<fn(int): int> = [quadrat, doubled];
print(fs[1](10));
print(alle(fs, 7));
var empty: fn(): void = fn_without;
empty();

fn fn_without(): void {
    print("without Parameter");
}

fn melder(): fn(): void {
    return fn_without;
}

melder()();

{
    var quadrat: fn(int): int = doubled;
    print(quadrat(6));
}
print(quadrat(6));
