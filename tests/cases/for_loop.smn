for (var i: int = 0; i < 3; i = i + 1) {
    print(i);
}

// backwards in steps of 4 (i is a new variable again, the old one is gone)
for (var i: int = 10; i > 0; i = i - 4) {
    print(i);
}

// condition false at the start: the body runs 0 times
for (var i: int = 5; i < 0; i = i + 1) {
    print("never");
}

// sum 1..10
var sum: int = 0;
for (var i: int = 1; i <= 10; i = i + 1) {
    sum = sum + i;
}
print(sum);

// nested loops
for (var a: int = 1; a <= 2; a = a + 1) {
    for (var b: int = 1; b <= 3; b = b + 1) {
        print(a * b);
    }
}

// continue still runs the step (otherwise k would stay 2 forever)
for (var k: int = 0; k < 5; k = k + 1) {
    if (k == 2) {
        continue;
    }
    print(k);
}

// break ends the loop at once
var last: int = 0;
for (var k: int = 0; k < 100; k = k + 1) {
    if (k == 3) {
        break;
    }
    last = k;
}
print(last);

// a float counter
for (var f: float = 0.5; f < 2.0; f = f + 0.5) {
    print(f);
}
