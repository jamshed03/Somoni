// '?' gives the value of an ok, or returns the err from the function at once
fn divide(a: int, b: int): result<int, string> {
    if (b == 0) {
        return err("Division by 0");
    }
    return ok(a / b);
}

fn compute(a: int, b: int, c: int): result<int, string> {
    var x: int = divide(a, b)?;
    print("first Step done");
    return ok(divide(x, c)? + 1);
}

fn sum(texts: list<string>): result<int, string> {
    var s: int = 0;
    for (t: string in texts) {
        s += int(t)?;
    }
    return ok(s);
}

fn check(n: int): result<bool, string> {
    if (n < 0) {
        return err("negative: " + string(n));
    }
    return ok(true);
}

fn all(numbers: list<int>): result<int, string> {
    for (n: int in numbers) {
        check(n)?;
    }
    return ok(len(numbers));
}

class Calculator {
    factor: int;

    constructor(factor: int) {
        this.factor = factor;
    }

    times(text: string): result<int, string> {
        return ok(int(text)? * this.factor);
    }

    both(a: string, b: string): result<int, string> {
        this.times(a)?;
        return this.times(b);
    }
}

print(compute(100, 5, 2));
print(compute(100, 0, 2));
print(compute(100, 5, 0));
print(sum(["1", "2", "3"]));
print(sum(["1", "x", "3"]));
print(all([1, 2, 3]));
print(all([1, -2, -3]));
var r: Calculator = new Calculator(3);
print(r.times("4"));
print(r.times("four"));
print(r.both("a", "2"));
print(r.both("1", "2"));
