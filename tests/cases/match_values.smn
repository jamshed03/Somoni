// match over strings and ints, with `_` for all other values, and ok(_) / err(_) without a name
fn name_of(sign: string): string {
    match (sign) {
        "+" => {
            return "plus";
        }
        "-" => {
            return "minus";
        }
        _ => {
            return "unknown";
        }
    }
}

fn size(n: int): string {
    match (n) {
        0 => {
            return "null";
        }
        -1 => {
            return "minus one";
        }
        1 => {
            return "one";
        }
        _ => {
            return "many";
        }
    }
}

print(name_of("+"));
print(name_of("-"));
print(name_of("*"));
print(size(0));
print(size(-1));
print(size(1));
print(size(42));

for (word: string in ["Ali", "Bea", "äöü"]) {
    match (word) {
        "äöü" => {
            print("Umlauts");
        }
        _ => {
            print("Name " + word);
        }
    }
}

match (int("12")) {
    ok(_) => {
        print("a number");
    }
    err(_) => {
        print("not a number");
    }
}
match (int("x")) {
    ok(n: int) => {
        print(n);
    }
    err(_) => {
        print("not a number");
    }
}
