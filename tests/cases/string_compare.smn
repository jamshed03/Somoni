// strings compare by character code
print("Anna" < "Bert");
print("Bert" > "Anna");
print("Anna" <= "Anna");
print("Anna" >= "Anne");
print("Z" < "a");
print("z" < "ä");
print("" < "a");
print("ab" < "abc");

var names: list<string> = ["Cem", "Ali", "Bea"];
var smallest: string = names[0];
for (n: string in names) {
    if (n < smallest) {
        smallest = n;
    }
}
print(smallest);
