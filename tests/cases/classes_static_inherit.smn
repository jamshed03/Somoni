// static methods and fields are inherited; an inherited static field is the same field
class Animal {
    static quantity: int = 0;
    protected static unit: string = "piece";
    private static secret: int = 7;

    constructor() {
        Animal::quantity += 1;
    }

    static create(): Animal {
        return new Animal();
    }

    static describe(): string {
        return string(Animal::quantity) + " " + Animal::unit + ", secret " + string(Animal::secret);
    }
}

class Dog extends Animal {
    constructor() {
        super();
        Dog::quantity += 10;
    }

    static count(): string {
        return string(Dog::quantity) + " " + Dog::unit;
    }
}

class Puppy extends Dog {
}

Animal::create();
var h: Dog = new Dog();
print(Animal::quantity);
print(Dog::quantity);
print(Puppy::quantity);
print(Dog::describe());
print(Puppy::count());
Puppy::quantity = 100;
print(Animal::quantity);
var t: Animal = Puppy::create();
print(Animal::quantity);
