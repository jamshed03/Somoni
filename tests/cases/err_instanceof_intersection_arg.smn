interface Shape {
    area(): int;
}

interface Named {
    label(): string;
}

class Animal {
    name: string;

    constructor(name: string) {
        this.name = name;
    }
}

fn label(n: Named): string {
    return n.label();
}

fn describe(a: Animal): void {
    if (a instanceof Shape) {
        print(label(a));
    }
}
