// static fields belong to the class and are read with Class::name
enum Color { Red, Green }
struct Point { x: int, y: int }

class Clock {
    static seconds: int = 60 * 60;
    static names: list<string> = ["Mo", "Di"];
    static color: Color = Color.Green;
    static origin: Point = Point { x: 0, y: -1 };
    private static secret: string = "x";
    static empty: string? = null;

    static show(): string {
        return Clock::secret + string(Clock::seconds);
    }
}

print(Clock::seconds);
print(Clock::names);
print(Clock::color);
print(Clock::origin);
print(Clock::show());
print(Clock::empty);
print(Clock::names[1]);
