fn divide(a: int, b: int): result<int, string> {
    if (b == 0) {
        return err("Division by 0");
    }
    return ok(a / b);
}

// both branches, the variable exists only in its branch
fn show(r: result<int, string>): void {
    match (r) {
        ok(n: int) => {
            print(n + 1);
        }
        err(n: string) => {
            print("Error: " + n);
        }
    }
}
show(divide(10, 2));
show(divide(1, 0));

// print, == and !=
var r: result<int, string> = ok(5);
print(r);
print(divide(1, 0));
print(r == ok(5));
print(ok(5) == r);
print(r != err("x"));
r = err("fresh");
print(r);

// every branch returns
fn or_null(r: result<int, string>): int {
    match (r) {
        ok(n: int) => {
            return n;
        }
        err(e: string) => {
            return 0;
        }
    }
}
print(or_null(divide(9, 3)));
print(or_null(divide(9, 0)));

// _ catches the other variant
match (divide(4, 0)) {
    ok(n: int) => {
        print(n);
    }
    _ => {
        print("no result");
    }
}

// other types inside, also in lists, structs and as argument
var empty: result<list<int>, string> = ok([]);
print(empty);
struct Answer {
    wert: result<float, bool>
}
var a: Answer = Answer { wert: err(false) };
print(a);
var alle: list<result<int, string>> = [ok(1), err("two"), ok(3)];
var sum: int = 0;
for (x: result<int, string> in alle) {
    match (x) {
        ok(n: int) => {
            sum += n;
        }
        err(e: string) => {
            print(e);
            continue;
        }
    }
}
print(sum);
show(ok(41));
var maybe: result<int?, string>? = ok(null);
print(maybe);
